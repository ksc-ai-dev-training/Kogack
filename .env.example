# ローカル開発用の設定（start.bat が読み込む。コピーして .env を作成）

# DBの動かし方: auto / docker / local
#   auto   … ローカルにPostgreSQLサービスがあればそれを使い、無ければDockerを使う（既定）
#   docker … Dockerコンテナ kogack-db を使う（Docker Desktopが必要）
#   local  … ローカルインストールしたPostgreSQLサービスを使う（Docker不要）
DB_MODE=auto

# PostgreSQLの公開ポート。Keireki（55432）と同時起動しても衝突しないよう既定を変えている
DB_PORT=55433

# DB_MODE=local のときに起動するWindowsサービス名。未設定なら postgresql-* を自動検出
#PG_SERVICE=postgresql-x64-16

# DB_MODE=docker のとき、エンジン未起動なら起動するDocker Desktopのパス（既定から変える場合のみ）
#DOCKER_DESKTOP=C:\Program Files\Docker\Docker\Docker Desktop.exe

# バックエンド（FastAPI/uvicorn）。Keireki（8010）と衝突しないよう既定8011
BACKEND_PORT=8011
# フロントエンド（Vite）。使用中の場合Viteが自動で次の空きポートに割り当てる
FRONTEND_PORT=5174

# ---------------------------------------------------------------------------
# 以下はローカル開発では不要（Koyeb/Supabase 用。Koyeb側の環境変数として設定する）
# ---------------------------------------------------------------------------

# 実行環境の識別。production にすると以下が自動で切り替わる:
#   ・開発用ログイン(/api/auth/dev-login)を強制無効化（DEV_AUTH=1 でも有効にならない）
#   ・セッションCookieに Secure 属性を付与
#   ・起動時の自動スキーマ適用(CREATE TABLE)を抑止
#   ・JWT_SECRET 未設定なら起動時にエラー
#APP_ENV=production

# Supabase の接続文字列。Supabase ダッシュボード > Connect から取得する。
# Koyeb のような常駐サーバーからは Session pooler（ポート5432）を推奨。
# ポート6543(Transaction pooler)を使う場合は statement_cache_size が自動で0になる。
# 末尾に ?sslmode=require を付けること。パスワードに記号が含まれる場合はURLエンコードする。
#DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# セッションJWTの署名鍵。本番では必須。十分に長いランダム文字列を設定する
#   生成例: python -c "import secrets; print(secrets.token_urlsafe(48))"
#JWT_SECRET=

# Google OAuth（A-01/A-02）。Google Cloud Console で作成したOAuthクライアントの値。
# 設定すると開発用ログインは自動的に無効になる（DEV_AUTH=1 で併用可）。
#GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=
# コールバックURL。未設定ならリクエストのホストから自動導出するため通常は不要。
# Google Cloud Console の「承認済みのリダイレクトURI」と完全一致させること。
#GOOGLE_REDIRECT_URI=https://<アプリ名>.koyeb.app/api/auth/callback
# ログインを許可するメールアドレスのドメイン（カンマ区切りで複数可）
#ALLOWED_DOMAINS=kogasoftware.com

# ---------------------------------------------------------------------------
# 以下は次スライス以降（AIサポート・座席予約連携）で使用する。今回は未使用
# ---------------------------------------------------------------------------

#OPENAI_API_KEY=sk-...
#AI_MODEL=gpt-4o-mini
#SEAT_RESERVATION_API_BASE=
